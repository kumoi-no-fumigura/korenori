 "poems": [
  {
   "seq": "1",
   "text": "淺綠そめてみたれる靑柳の糸をは春のかせやとくらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "折とらはをしけにも有か櫻花いさ宿かりてちるまではみむ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "櫻花けふよくみてん吳竹のひとよの程にちりもこそすれ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "かつみつゝ千年の春をすくすともいつかは花の色にあくへき",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "花の色を移しとゝめよ鏡山春より後のかけやみゆると",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "三千とせになるてふ桃の〓としより花咲春にあひにける哉",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "深綠ときはの松の陰にゐて移ろふ色をよそにこそみれ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "きつゝのみ鳴鶯の故里は散にし梅の花にそありける",
   "kana": "",
   "speaker": "坂上是則集",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "山かつと人はいへとも時鳥まつ初聲はわれのみぞきく",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "はつ時雨ふるほともなくさほ山の梢あまたに色つきにけり",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "大かたにおく白露も今よりは心してこそみるへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "秋の色は千種なからにかはれるをたれか小倉の山といふらん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いつかたかとまりなるらん山風の拂ふ紅葉にふなちまとひぬ",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "みね高く行てみるへき紅葉はを我ゐなからもかさしつる哉",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "さほ山のはゝその色は淺けれと秋は深くも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "紅葉はのおちてなかるゝ大井川せゝのしら浪かけもとめなん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "もみちはの流れさりせは立田川水の秋をはたれかしらまし",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "かけさへにいまはと菊の移れるは浪の底にも霜やおくらん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いくさとのある道なれや秋〓にに雲井の旅のかりのゆくらん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "かりてほす山田の稻のこきたにて鳴こそ波れ秋のうけれは",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "朝ほらけ有明の月とみるまてによしのゝ里にふれる白雪",
   "kana": "",
   "speaker": "山イ",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "みよしのゝ山のしら雪積るらし故里さむくなりまさるなり",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "冬の池のうへは氷のとちたるをいかてか月の底にいるらん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "君か代は天の羽衣まれにきてなつともつきぬいはほならなん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "わたの原かつきてしらん人しれずおもふ心のふかさくらへに",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "我戀をくらふの山の櫻花まなく散とも數はまさらし",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "を鹿ふす夏のゝ草の道みえずしけき戀にもまとふころ哉",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "秋山に朝たつ霧のみねこめてはれすそ物をおもふへらなる",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "霜かれの淺ちかもとの苅萱のみたれて物をおもふころ哉",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "枕のみうくと思ひし涙川今は我身のしづむなりけり",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "かつきえぬ泪か磯のあはひゆゑ海よりうみはかつきつくしつ",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "片糸をこなたかなたによりかけてあはすは何を玉の〓にせん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "谷深み岩まをたきつ山河のおとにのみやはきゝわたるへき",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "戀しさの限りたにあるよなりせは年へて物は思はさらまし",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "逢ふ〓ををなからの橋のなからへて戀わたるまに年そへにける",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "あひみては慰むやとそ思ひしをなこりまて社戀しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "霧ふかき秋のゝなかの忘れ水たえまかちなるころにも有哉",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "秋のよをまとろまてのみあかすみは夢ちとのみも賴まさり鳬",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "忘るなよ別ちに生るくすのはの秋風ふかはいまかへりこん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "此川の入江の松は老にけりふるき御幸のことやとはまし",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "山ちかみおりゐる雲とまな鶴の立る河へを人やみるらん",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "行舟になるゝ鷗はさす棹のかへす浪にそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "秋山のかひにみかへりなく猿を夜ふかく聞て袖そぬれぬる",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "秋の野に置白露のきえさらは玉にぬきてもかけて見てまし",
   "kana": "",
   "speaker": "",
   "page": 302,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
